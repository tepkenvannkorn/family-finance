RewriteEngine On

# Serve existing files/directories (assets) directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else goes through the front controller
RewriteRule ^ index.php [L]

# Never serve dotfiles (.env, .git, etc.) even if misplaced under /public
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
