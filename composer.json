{
    "name": "family/finance-app",
    "description": "Self-hosted family income & expense manager",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-bcmath": "*",
        "ext-fileinfo": "*",
        "vlucas/phpdotenv": "^5.6",
        "dompdf/dompdf": "^3.0",
        "phpoffice/phpspreadsheet": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\": "database/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true
    }
}
